{
    "name": "nut-house-portal",
    "version": "1.0.0",
    "description": "Nut House ERP Phase 2A Cloudflare Worker backend foundation",
    "main": "src/index.ts",
    "scripts": {
        "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
        "dev:wrangler": "wrangler dev",
        "test": "vitest run",
        "test:e2e:inventory": "playwright test tests/e2e/inventory-hardening.spec.ts",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "frontend:build": "node scripts/build-frontend-assets.mjs",
        "frontend:check": "npm run frontend:build && node scripts/check-frontend-modules.mjs",
        "typecheck": "tsc --noEmit",
        "check:deploy-config": "node scripts/validate-deploy-config.mjs wrangler.jsonc",
        "sample:accounts": "node scripts/sample-accounts.mjs",
        "sample:catalog": "node scripts/sample-demo-catalog.mjs",
        "cf:types": "wrangler types",
        "verify": "node scripts/verify.mjs",
        "status:ops": "node scripts/status-ops.mjs",
        "deploy": "wrangler deploy"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/newwavedigital/nutty-paws-erp.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "bugs": {
        "url": "https://github.com/newwavedigital/nutty-paws-erp/issues"
    },
    "homepage": "https://github.com/newwavedigital/nutty-paws-erp#readme",
    "dependencies": {
        "hono": "^4.12.25"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260609.1",
        "@playwright/test": "^1.61.1",
        "@types/node": "^25.9.2",
        "@vitest/coverage-v8": "^4.1.8",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8",
        "wrangler": "^4.98.0"
    }
}
